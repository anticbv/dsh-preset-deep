{
  "name": "dsh-preset-deep",
  "version": "0.1.3",
  "author": "anticbv",
  "description": "梁圣模式：DeepSeek Harness 的第五个工作模式——计划必须可证伪，结论必须带证据等级。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "assets",
    "examples",
    "skills",
    "scripts",
    "ci",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "validate": "node scripts/validate.cjs",
    "test:icon": "node scripts/test-icon.cjs",
    "acceptance": "node scripts/acceptance.cjs",
    "test": "node scripts/validate.cjs && node scripts/test-icon.cjs"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "agent-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anticbv/dsh-preset-deep.git"
  },
  "homepage": "https://github.com/anticbv/dsh-preset-deep#readme",
  "bugs": {
    "url": "https://github.com/anticbv/dsh-preset-deep/issues"
  },
  "license": "MIT OR Apache-2.0"
}
